{
  "name": "youtube-enhance-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zena'nın video pipeline'ı: script.md içindeki 📍 işaretlerini ses kaydına hizalar ve Remotion ile videonun üstüne yerleştirir.",
  "scripts": {
    "yt": "tsx src/pipeline/cli.ts",
    "new": "tsx src/pipeline/cli.ts new",
    "lint": "tsx src/pipeline/cli.ts lint",
    "align": "tsx src/pipeline/cli.ts align",
    "assets": "tsx src/pipeline/cli.ts assets",
    "foto": "tsx src/pipeline/cli.ts foto",
    "studio": "tsx src/pipeline/cli.ts studio",
    "render": "tsx src/pipeline/cli.ts render",
    "pipeline": "tsx src/pipeline/cli.ts all",
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "app": "npm run ui:build && electron .",
    "app:dev": "electron .",
    "icon": "tsx scripts/make-icon.ts",
    "launcher": "bash scripts/make-launcher.sh",
    "timing": "tsx src/pipeline/cli.ts timing",
    "stats": "tsx src/pipeline/cli.ts stats",
    "skill:sync": "tsx scripts/skill-sync.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/google-fonts": "^4.0.536",
    "@remotion/media-utils": "^4.0.536",
    "@remotion/player": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.4"
  },
  "main": "electron/main.cjs"
}
